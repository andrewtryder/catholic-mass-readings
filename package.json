{
  "name": "catholic-mass-readings",
  "version": "0.5.0",
  "description": "TypeScript library and CLI for querying Daily Mass readings from bible.usccb.org",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Andrew Ryder",
  "homepage": "https://github.com/andrewtryder/catholic-mass-readings#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewtryder/catholic-mass-readings.git"
  },
  "bugs": {
    "url": "https://github.com/andrewtryder/catholic-mass-readings/issues"
  },
  "keywords": [
    "catholic",
    "mass",
    "readings",
    "usccb",
    "lectionary",
    "bible",
    "liturgy",
    "cli",
    "scraper"
  ],
  "bin": {
    "catholic-mass-readings": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "node --import tsx src/cli.ts",
    "cli": "node --import tsx src/cli.ts",
    "docs": "typedoc",
    "prepare": "husky",
    "prepack": "npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "commander": "^15.0.0"
  },
  "optionalDependencies": {
    "impit": "^0.14.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "prettier": "^3.6.2",
    "tsx": "^4.19.4",
    "typedoc": "^0.28.5",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.35.1",
    "vitest": "^4.0.0"
  }
}

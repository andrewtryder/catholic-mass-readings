{
  "name": "catholic-mass-readings",
  "version": "0.1.0",
  "description": "API and CLI for querying Daily Mass readings from bible.usccb.org",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Andrew Ryder",
  "homepage": "https://github.com/andrewtryder/catholic-mass-readings#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewtryder/catholic-mass-readings.git"
  },
  "bugs": {
    "url": "https://github.com/andrewtryder/catholic-mass-readings/issues"
  },
  "keywords": [
    "catholic",
    "mass",
    "readings",
    "usccb",
    "lectionary",
    "bible",
    "liturgy",
    "cli",
    "scraper"
  ],
  "bin": {
    "catholic-mass-readings": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "cli": "tsx src/cli.ts",
    "prepare": "husky",
    "prepack": "npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:types": "wrangler types"
  },
  "engines": {
    "node": "24"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "commander": "^13.1.0"
  },
  "optionalDependencies": {
    "impit": "^0.14.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250610.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.30.1",
    "@types/node": "^22.15.21",
    "@vitest/coverage-v8": "^3.2.1",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^3.2.1",
    "wrangler": "^4.19.0"
  }
}

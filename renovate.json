{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "prHourlyLimit": 1,
  "prConcurrentLimit": 4,
  "dependencyDashboard": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 4am on monday"],
    "groupName": "lock file maintenance"
  },
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch", "minor", "pin", "digest"],
      "groupName": "npm non-major dependencies",
      "groupSlug": "npm-non-major"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "minor", "pin", "digest"],
      "groupName": "github actions non-major updates",
      "groupSlug": "github-actions-non-major"
    },
    {
      "matchPackageNames": ["vitest", "@vitest/coverage-v8"],
      "matchUpdateTypes": ["major"],
      "groupName": "vitest major updates",
      "groupSlug": "vitest-major"
    },
    {
      "matchPackageNames": ["node", "actions/node-versions", "cimg/node"],
      "matchUpdateTypes": ["major"],
      "groupName": "node runtime major updates",
      "groupSlug": "node-major"
    },
    {
      "matchUpdateTypes": ["major"],
      "excludePackageNames": [
        "vitest",
        "@vitest/coverage-v8",
        "node",
        "actions/node-versions",
        "cimg/node"
      ],
      "groupName": "major dependency updates",
      "groupSlug": "major-dependencies"
    },
    {
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "22.x",
      "groupName": "minimum Node compatibility types"
    },
    {
      "matchPackageNames": ["commander"],
      "allowedVersions": "<15.0.0",
      "groupName": "Node >= 22 compatible commander"
    },
    {
      "matchPackageNames": [
        "@commitlint/cli",
        "@commitlint/config-conventional"
      ],
      "allowedVersions": "<21.0.0",
      "groupName": "Node >= 22 compatible commitlint"
    },
    {
      "matchPackageNames": ["lint-staged"],
      "allowedVersions": "<17.0.0",
      "groupName": "Node >= 22 compatible lint-staged"
    },
    {
      "matchPackageNames": ["cimg/node"],
      "allowedVersions": "22.x",
      "groupName": "Node >= 22 canary Docker image"
    },
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1.0",
      "groupName": "tooling compatible TypeScript"
    }
  ]
}

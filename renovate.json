{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "prHourlyLimit": 1,
  "prConcurrentLimit": 4,
  "dependencyDashboard": true,
  "lockFileMaintenance": {
    "enabled": true,
    "groupName": "lock file maintenance"
  },
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch", "minor", "pin", "digest"],
      "groupName": "npm non-major dependencies",
      "groupSlug": "npm-non-major"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "minor", "pin", "digest"],
      "groupName": "github actions non-major updates",
      "groupSlug": "github-actions-non-major"
    },
    {
      "matchUpdateTypes": ["major"],
      "groupName": "major dependency updates",
      "groupSlug": "major-dependencies"
    },
    {
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "20.x",
      "groupName": "minimum Node compatibility types"
    },
    {
      "matchPackageNames": ["commander"],
      "allowedVersions": "<15.0.0",
      "groupName": "Node >= 20 compatible commander"
    },
    {
      "matchPackageNames": [
        "@commitlint/cli",
        "@commitlint/config-conventional"
      ],
      "allowedVersions": "<21.0.0",
      "groupName": "Node >= 20 compatible commitlint"
    },
    {
      "matchPackageNames": ["lint-staged"],
      "allowedVersions": "<17.0.0",
      "groupName": "Node >= 20 compatible lint-staged"
    },
    {
      "matchPackageNames": ["cimg/node"],
      "allowedVersions": "20.x",
      "groupName": "Node >= 20 canary Docker image"
    },
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1.0",
      "groupName": "Node >= 20 & tooling compatible TypeScript"
    }
  ]
}
